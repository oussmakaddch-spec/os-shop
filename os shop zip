const { createClient } = require("@supabase/supabase-js");
// المفتاح السري (service role) يبقى في متغيرات Netlify فقط، لا يظهر في المتصفح أبدًا
const sb = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_SERVICE_ROLE_KEY, {
  auth: { persistSession: false, autoRefreshToken: false },
});
async function userFrom(event) {
  const t = (event.headers.authorization || "").replace("Bearer ", "");
  const { data, error } = await sb.auth.getUser(t);
  if (error || !data || !data.user) throw new Error("auth");
  return data.user;
}
module.exports = { sb, userFrom };
